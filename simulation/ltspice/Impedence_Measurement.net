* Z:\home\voidness\Storage\Synced Folders\MEI Project\MEI_Impedance_Meter\simulation\ltspice\Impedence_Measurement.asc
V1 N002 0 SINE(1.65 0.9 500) AC 0.9
R1 N003 N002 40
R2 N010 N009 40
R3 N011 N010 1000
R4 N004 N003 1000
R5 N012 N011 1000
R6 N005 N004 1000
C1 N004 0 100n
C2 N005 0 100n
C3 N012 0 100n
C4 N011 0 100n
XU1 N005 N001 N008 0 N001 opamp2 Avol=100k GBW=1Meg Slew=0.6Meg rail=25m
XU2 N012 N013 N008 0 N013 opamp2 Avol=100k GBW=1Meg Slew=0.6Meg rail=25m
R7 N006 N001 {Rref}
R8 adc0 N001 100
C5 0 adc0 1.005n
XU3 N006 N007 N008 0 N007 opamp2 Avol=100k GBW=1Meg Slew=0.6Meg rail=25m
R12 N006 Node {Rd}
L1 Node N013 {Ld}
R13 adc1 N007 100
C6 adc1 0 1.005n
V4 N008 0 3.3
V2 N009 0 1.65
.param case=1
.param Rref={table(case,1,100,2,9.9k,3,9.9k,4,9.9k,5,1k,6,1k,7,9.9k)}
.param Rd={table(case,1,100,2,6.15k,3,4.7k,4,2.664k,5,220,6,2k,7,1k)}
.param Ld={table(case,1,10m,2,1n,3,1n,4,1n,5,1n,6,1n,7,100m)}
.step param case 1 7 1
.ac list 125 250 500 1000
.subckt opamp2 inp inn vp vn out params: Avol=1Meg GBW=10Meg Slew=10Meg rail=0 Rout=100
G1 0 n1 inp inn 1m
Rp n1 0 {Avol/1m}
Cp n1 0 {1m/(2*3.14159265*GBW)}
B1 mid 0 V=min(max(V(n1),V(vn)+rail),V(vp)-rail)
Ro mid out {Rout}
.ends opamp2
.backanno
.end
